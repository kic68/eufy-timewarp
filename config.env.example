# eufy-timewarp configuration -- copy to config.env and edit, then run ./install.sh
# config.env is git-ignored so your real values never get committed.
#
# Flags are ordered by how likely you are to change them: the MUST-SET block is
# first, then a should-set, then everything that already works at its default on
# a stock Raspberry Pi + E1. See the README "Configuration" section for detail.

# ============================================================================
# MUST SET -- the install is not correct until these are your real values
# ============================================================================

# If you decide not to use a Raspberry but use the second interface as
# connection to an already configured access point - set this to no and all
# hostapd related steps will be skipped.
CONFIGURE_WIFI=yes

# WPA2 passphrase for the AP, 8-63 chars. The default below is a placeholder;
# leaving it means your printer's network is wide open.
AP_PASSPHRASE=change-me-8-to-63-chars

# Your printer's WiFi MAC (lowercase, colons). This is how the firewall knows
# which client to isolate. Find it in the eufyMake app (device settings ->
# Device Info / Network), or read it off the AP with `iw dev wlan0 station dump`
# after the printer joins. See the README.
PRINTER_MAC=aa:bb:cc:dd:ee:ff

# A date BEFORE your ink cartridge's expiry. Served as UTC. Keep the quotes. The
# served time advances in real time from here; a monthly cron resets it back so
# it stays within ~1 month of this date (short of the real expiry) while still
# letting enough time pass for the printer's scheduled maintenance to run.
# Change any time with `sudo set-fake-date "YYYY-MM-DD HH:MM:SS"`.
FAKE_DATE="2026-05-04 00:00:00"

# ============================================================================
# SHOULD SET -- for legal reasons
# ============================================================================

# Your 2-letter regulatory domain (US, DE, GB, AT, ...). Keeps the WiFi radio's
# channels/power legal for where you are.
AP_COUNTRY=US

# ============================================================================
# DEFAULTS ARE FINE -- change only if they clash with your hardware/network
# ============================================================================

# --- interfaces -- correct for a standard Pi (built-in wifi + ethernet) ------
AP_IFACE=wlan0            # WiFi interface that becomes the isolated access point
UPLINK_IFACE=eth0         # interface WITH real internet (gives control device NAT)

# --- access point (cosmetic) -------------------------------------------------
AP_SSID=eufy-lab
AP_CHANNEL=6              # 2.4 GHz channel (1, 6 or 11 are safest)

# --- AP network -- fine unless your uplink is ALSO 192.168.50.x --------------
AP_IP=192.168.50.1
AP_CIDR=24
AP_SUBNET=192.168.50.0/24
DHCP_START=192.168.50.50
DHCP_END=192.168.50.150
PRINTER_IP=192.168.50.60         # fixed lease the printer gets (inside the subnet)
