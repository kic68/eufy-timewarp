# eufy-iso configuration -- copy to config.env and edit, then run ./install.sh
# config.env is git-ignored so your real values never get committed.

# --- interfaces --------------------------------------------------------------
AP_IFACE=wlan0            # WiFi interface that becomes the isolated access point
UPLINK_IFACE=eth0         # interface WITH real internet (gives control device NAT)

# --- access point ------------------------------------------------------------
AP_SSID=eufy-lab
AP_PASSPHRASE=change-me-8-to-63-chars    # WPA2 passphrase, 8-63 characters
AP_COUNTRY=AT             # your 2-letter regulatory domain (US, DE, GB, ...)
AP_CHANNEL=6              # 2.4 GHz channel (1, 6 or 11 are safest)

# --- AP network --------------------------------------------------------------
AP_IP=192.168.50.1
AP_CIDR=24
AP_SUBNET=192.168.50.0/24
DHCP_START=192.168.50.50
DHCP_END=192.168.50.150

# --- the printer -------------------------------------------------------------
PRINTER_MAC=aa:bb:cc:dd:ee:ff    # your printer's WiFi MAC (lowercase, colons)
PRINTER_IP=192.168.50.60         # fixed lease it will get (inside the subnet)

# --- fake clock --------------------------------------------------------------
# A date BEFORE your ink cartridge's expiry. Served as UTC. A daily cron resets
# to this so it never drifts forward toward the real expiry. Change any time with
# `sudo set-fake-date "YYYY-MM-DD HH:MM:SS"`.
FAKE_DATE=2026-05-04 00:00:00
