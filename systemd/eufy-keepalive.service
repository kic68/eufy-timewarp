[Unit]
Description=eufy-timewarp keepalive (HTTP probe responder + TCP sink so the printer stays associated)
After=network.target systemd-networkd.service
Wants=network.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /usr/local/lib/eufy-timewarp/keepalive.py
Restart=always
RestartSec=3
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_INET

[Install]
WantedBy=multi-user.target
